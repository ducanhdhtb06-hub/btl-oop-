digraph UML {
  graph [fontname="DejaVu Sans", fontsize=17, label=<<B>Biểu đồ lớp 2 - Kiến trúc phân tầng (ui → service → repository)</B>>, labelloc=t, labeljust=c,
         rankdir=TB, nodesep=0.5, ranksep=0.8, newrank=true, pad=0.35, bgcolor=white];
  node [shape=plain, fontname="DejaVu Sans", fontsize=11];
  edge [fontname="DejaVu Sans", fontsize=10, color="#333333", arrowsize=0.95, labelfontsize=10, labelfontcolor="#1a1a1a"];
  subgraph cluster_ui {
    label=<<B>restaurant.ui</B>>; labeljust=l; fontsize=13; style="rounded"; color="#8a8a8a"; bgcolor="#fbfbfb"; penwidth=1.2;
    c_ConsoleMenu [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#3a3a3a" BGCOLOR="#eef3fa"><TR><TD ALIGN="CENTER" CELLPADDING="5"><B>ConsoleMenu</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">-out : PrintStream<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+ConsoleMenu(input: InputReader, out: PrintStream,<BR ALIGN="LEFT"/>&#160;&#160;&#160;&#160;menu: MenuService, tables: TableService,<BR ALIGN="LEFT"/>&#160;&#160;&#160;&#160;orders: OrderService)<BR ALIGN="LEFT"/>+run() : void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    c_InputReader [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#3a3a3a" BGCOLOR="#eef3fa"><TR><TD ALIGN="CENTER" CELLPADDING="5"><B>InputReader</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">-in : Scanner<BR ALIGN="LEFT"/>-out : PrintStream<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+InputReader(in: Scanner, out: PrintStream)<BR ALIGN="LEFT"/>+readInt(prompt: String, min: int, max: int) : int<BR ALIGN="LEFT"/>+readNonBlank(prompt: String) : String<BR ALIGN="LEFT"/>+confirm(prompt: String) : boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    subgraph cluster_ui_swing {
      label=<<B>restaurant.ui.swing</B>>; labeljust=l; fontsize=13; style="rounded"; color="#8a8a8a"; bgcolor="#fbfbfb"; penwidth=1.2;
      c_MainWindow [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#3a3a3a" BGCOLOR="#eef3fa"><TR><TD ALIGN="CENTER" CELLPADDING="5"><B>MainWindow</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">-frame : JFrame<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+MainWindow(menu: MenuService, tables: TableService,<BR ALIGN="LEFT"/>&#160;&#160;&#160;&#160;orders: OrderService)<BR ALIGN="LEFT"/>+show() : void<BR ALIGN="LEFT"/>+showWarnings(warnings: List&lt;String&gt;) : void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    }
  }
  subgraph cluster_pricing {
    label=<<B>restaurant.pricing</B>>; labeljust=l; fontsize=13; style="rounded"; color="#8a8a8a"; bgcolor="#fbfbfb"; penwidth=1.2;
    c_BillCalculator [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#3a3a3a" BGCOLOR="#eef3fa"><TR><TD ALIGN="CENTER" CELLPADDING="5"><B>BillCalculator</B></TD></TR></TABLE>>];
    c_DiscountStrategy [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#3a3a3a" BGCOLOR="#fff8e1"><TR><TD ALIGN="CENTER" CELLPADDING="5"><FONT POINT-SIZE="10">«interface»</FONT><BR/><B>DiscountStrategy</B></TD></TR></TABLE>>];
  }
  subgraph cluster_common {
    label=<<B>restaurant.common</B>>; labeljust=l; fontsize=13; style="rounded"; color="#8a8a8a"; bgcolor="#fbfbfb"; penwidth=1.2;
    c_BillFormatter [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#3a3a3a" BGCOLOR="#eef3fa"><TR><TD ALIGN="CENTER" CELLPADDING="5"><FONT POINT-SIZE="10">«utility»</FONT><BR/><B>BillFormatter</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><U>-TIME : DateTimeFormatter</U><BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><U>+format(bill: Bill) : String</U><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    c_MoneyFormat [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#3a3a3a" BGCOLOR="#eef3fa"><TR><TD ALIGN="CENTER" CELLPADDING="5"><FONT POINT-SIZE="10">«utility»</FONT><BR/><B>MoneyFormat</B></TD></TR><HR/><TR><TD CELLPADDING="1"> </TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><U>+format(amount: long) : String</U><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  }
  subgraph cluster_model {
    label=<<B>restaurant.model</B>>; labeljust=l; fontsize=13; style="rounded"; color="#8a8a8a"; bgcolor="#fbfbfb"; penwidth=1.2;
    c_MenuItemFactory [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#3a3a3a" BGCOLOR="#eef3fa"><TR><TD ALIGN="CENTER" CELLPADDING="5"><FONT POINT-SIZE="10">«utility»</FONT><BR/><B>MenuItemFactory</B></TD></TR></TABLE>>];
  }
  subgraph cluster_restaurant {
    label=<<B>restaurant</B>>; labeljust=l; fontsize=13; style="rounded"; color="#8a8a8a"; bgcolor="#fbfbfb"; penwidth=1.2;
    c_Main [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#3a3a3a" BGCOLOR="#eef3fa"><TR><TD ALIGN="CENTER" CELLPADDING="5"><B>Main</B></TD></TR><HR/><TR><TD CELLPADDING="1"> </TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><U>+main(args: String[]) : void</U><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    c_ChayGiaoDien [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#3a3a3a" BGCOLOR="#eef3fa"><TR><TD ALIGN="CENTER" CELLPADDING="5"><B>ChayGiaoDien</B></TD></TR><HR/><TR><TD CELLPADDING="1"> </TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><U>+main(args: String[]) : void</U><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    c_ChayConsole [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#3a3a3a" BGCOLOR="#eef3fa"><TR><TD ALIGN="CENTER" CELLPADDING="5"><B>ChayConsole</B></TD></TR><HR/><TR><TD CELLPADDING="1"> </TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><U>+main(args: String[]) : void</U><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    c_ChayDemo [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#3a3a3a" BGCOLOR="#eef3fa"><TR><TD ALIGN="CENTER" CELLPADDING="5"><B>ChayDemo</B></TD></TR><HR/><TR><TD CELLPADDING="1"> </TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><U>+main(args: String[]) : void</U><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  }
  subgraph cluster_service {
    label=<<B>restaurant.service</B>>; labeljust=l; fontsize=13; style="rounded"; color="#8a8a8a"; bgcolor="#fbfbfb"; penwidth=1.2;
    c_MenuService [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#3a3a3a" BGCOLOR="#eef3fa"><TR><TD ALIGN="CENTER" CELLPADDING="5"><B>MenuService</B></TD></TR><HR/><TR><TD CELLPADDING="1"> </TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+MenuService(repo: Repository&lt;MenuItem, String&gt;)<BR ALIGN="LEFT"/>+all() : List&lt;MenuItem&gt;<BR ALIGN="LEFT"/>+byType(type: ItemType) : List&lt;MenuItem&gt;<BR ALIGN="LEFT"/>+vegetarian() : List&lt;MenuItem&gt;<BR ALIGN="LEFT"/>+find(id: String) : MenuItem<BR ALIGN="LEFT"/>+addFood(name: String, price: long,<BR ALIGN="LEFT"/>&#160;&#160;&#160;&#160;vegetarian: boolean) : Food<BR ALIGN="LEFT"/>+addDrink(name: String, price: long, volumeMl: int) : Drink<BR ALIGN="LEFT"/>+changePrice(id: String, newPrice: long) : void<BR ALIGN="LEFT"/>+setAvailable(id: String, available: boolean) : void<BR ALIGN="LEFT"/>+toggleAvailable(id: String) : boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    c_TableService [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#3a3a3a" BGCOLOR="#eef3fa"><TR><TD ALIGN="CENTER" CELLPADDING="5"><B>TableService</B></TD></TR><HR/><TR><TD CELLPADDING="1"> </TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+TableService(repo: Repository&lt;Table, Integer&gt;)<BR ALIGN="LEFT"/><U>+defaultTables() : List&lt;Table&gt;</U><BR ALIGN="LEFT"/>+all() : List&lt;Table&gt;<BR ALIGN="LEFT"/>+find(number: int) : Table<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    c_OrderService [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#3a3a3a" BGCOLOR="#eef3fa"><TR><TD ALIGN="CENTER" CELLPADDING="5"><B>OrderService</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">-clock : Clock<BR ALIGN="LEFT"/>-nextOrderId : int<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+OrderService(orders: Repository&lt;Order, Integer&gt;,<BR ALIGN="LEFT"/>&#160;&#160;&#160;&#160;tables: TableService, menu: MenuService,<BR ALIGN="LEFT"/>&#160;&#160;&#160;&#160;calculator: BillCalculator, archive: BillArchive,<BR ALIGN="LEFT"/>&#160;&#160;&#160;&#160;clock: Clock)<BR ALIGN="LEFT"/>+openOrder(tableNo: int) : Order<BR ALIGN="LEFT"/>+currentOrder(tableNo: int) : Order<BR ALIGN="LEFT"/>+addItem(tableNo: int, itemId: String, quantity: int) : void<BR ALIGN="LEFT"/>+updateQuantity(tableNo: int, itemId: String,<BR ALIGN="LEFT"/>&#160;&#160;&#160;&#160;quantity: int) : void<BR ALIGN="LEFT"/>+removeItem(tableNo: int, itemId: String) : void<BR ALIGN="LEFT"/>+checkout(tableNo: int,<BR ALIGN="LEFT"/>&#160;&#160;&#160;&#160;strategy: DiscountStrategy) : CheckoutResult<BR ALIGN="LEFT"/>+cancel(tableNo: int) : void<BR ALIGN="LEFT"/>+bestSellers(limit: int) : List&lt;ItemSales&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    c_CheckoutResult [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#3a3a3a" BGCOLOR="#eef7ee"><TR><TD ALIGN="CENTER" CELLPADDING="5"><FONT POINT-SIZE="10">«record»</FONT><BR/><B>CheckoutResult</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">-bill : Bill<BR ALIGN="LEFT"/>-archived : boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    c_ItemSales [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#3a3a3a" BGCOLOR="#eef7ee"><TR><TD ALIGN="CENTER" CELLPADDING="5"><FONT POINT-SIZE="10">«record»</FONT><BR/><B>ItemSales</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">-itemName : String<BR ALIGN="LEFT"/>-quantity : int<BR ALIGN="LEFT"/>-revenue : long<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  }
  subgraph cluster_repository {
    label=<<B>restaurant.repository</B>>; labeljust=l; fontsize=13; style="rounded"; color="#8a8a8a"; bgcolor="#fbfbfb"; penwidth=1.2;
    c_Repository [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#3a3a3a" BGCOLOR="#fff8e1"><TR><TD ALIGN="CENTER" CELLPADDING="5"><FONT POINT-SIZE="10">«interface»</FONT><BR/><B>Repository&lt;T extends Identifiable&lt;ID&gt;, ID&gt;</B></TD></TR><HR/><TR><TD CELLPADDING="1"> </TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><I>+findAll() : List&lt;T&gt;</I><BR ALIGN="LEFT"/><I>+findById(id: ID) : Optional&lt;T&gt;</I><BR ALIGN="LEFT"/><I>+save(entity: T) : void</I><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    c_InMemoryRepository [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#3a3a3a" BGCOLOR="#eef3fa"><TR><TD ALIGN="CENTER" CELLPADDING="5"><B>InMemoryRepository&lt;T extends Identifiable&lt;ID&gt;, ID&gt;</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">-entities : Map&lt;ID, T&gt;<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+findAll() : List&lt;T&gt;<BR ALIGN="LEFT"/>+findById(id: ID) : Optional&lt;T&gt;<BR ALIGN="LEFT"/>+save(entity: T) : void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    c_FileMenuRepository [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#3a3a3a" BGCOLOR="#eef3fa"><TR><TD ALIGN="CENTER" CELLPADDING="5"><B>FileMenuRepository</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><U>+HEADER : String</U><BR ALIGN="LEFT"/>-file : Path<BR ALIGN="LEFT"/>-items : Map&lt;String, MenuItem&gt;<BR ALIGN="LEFT"/>-warnings : List&lt;String&gt;<BR ALIGN="LEFT"/>-skippedRows : List&lt;String&gt;<BR ALIGN="LEFT"/>-writable : boolean<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+FileMenuRepository(file: Path)<BR ALIGN="LEFT"/>+getWarnings() : List&lt;String&gt;<BR ALIGN="LEFT"/>+findAll() : List&lt;MenuItem&gt;<BR ALIGN="LEFT"/>+findById(id: String) : Optional&lt;MenuItem&gt;<BR ALIGN="LEFT"/>+save(item: MenuItem) : void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    c_SampleMenu [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#3a3a3a" BGCOLOR="#eef3fa"><TR><TD ALIGN="CENTER" CELLPADDING="5"><FONT POINT-SIZE="10">«utility»</FONT><BR/><B>SampleMenu</B></TD></TR><HR/><TR><TD CELLPADDING="1"> </TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><U>+items() : List&lt;MenuItem&gt;</U><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    c_BillArchive [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#3a3a3a" BGCOLOR="#fff8e1"><TR><TD ALIGN="CENTER" CELLPADDING="5"><FONT POINT-SIZE="10">«interface»</FONT><BR/><B>BillArchive</B></TD></TR><HR/><TR><TD CELLPADDING="1"> </TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><I>+archive(bill: Bill) : void</I><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    c_FileBillArchive [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#3a3a3a" BGCOLOR="#eef3fa"><TR><TD ALIGN="CENTER" CELLPADDING="5"><B>FileBillArchive</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">-file : Path<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+FileBillArchive(file: Path)<BR ALIGN="LEFT"/>+archive(bill: Bill) : void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  }
  note0 [shape=note, style=filled, fillcolor="#fffde7", color="#9e9e9e", fontsize=10, margin="0.12,0.06", label=<Tạo các đối tượng chính rồi truyền vào nhau<BR/>qua hàm tạo: FileMenuRepository, 2<BR/>InMemoryRepository, MenuService,<BR/>TableService, OrderService, BillCalculator,<BR/>FileBillArchive, rồi ConsoleMenu và<BR/>InputReader, hoặc MainWindow nếu có --gui>];
  c_Main -> note0 [style=dashed, arrowhead=none, color="#9e9e9e"];
  note1 [shape=note, style=filled, fillcolor="#fffde7", color="#9e9e9e", fontsize=10, margin="0.12,0.06", label=<ConsoleMenu và MainWindow tạo NoDiscount,<BR/>PercentageDiscount hoặc FixedAmountDiscount<BR/>(hình 1) rồi truyền vào<BR/>OrderService.checkout>];
  c_DiscountStrategy -> note1 [style=dashed, arrowhead=none, color="#9e9e9e"];
  note2 [shape=note, style=filled, fillcolor="#fffde7", color="#9e9e9e", fontsize=10, margin="0.12,0.06", label=<ConsoleMenu và MainWindow cũng dùng<BR/>BillFormatter và MoneyFormat để in hóa đơn<BR/>và giá tiền (không vẽ các đường này cho đỡ<BR/>rối)>];
  c_BillFormatter -> note2 [style=dashed, arrowhead=none, color="#9e9e9e"];
  note3 [shape=note, style=filled, fillcolor="#fffde7", color="#9e9e9e", fontsize=10, margin="0.12,0.06", label=<Còn 12 thuộc tính giao diện khác (bảng, ô số<BR/>lượng, ô giảm giá...) không vẽ cho gọn. Giữ<BR/>JFrame bên trong thay vì kế thừa JFrame>];
  c_MainWindow -> note3 [style=dashed, arrowhead=none, color="#9e9e9e"];
  c_Main -> c_ConsoleMenu [style=invis];
  c_Main -> c_MainWindow [style=invis];
  { rank=same; c_ConsoleMenu c_MainWindow }
  c_ChayGiaoDien -> c_Main [style=dashed, arrowhead=vee, color="#555555", label=" «call» ", fontcolor="#444444"];
  c_ChayConsole -> c_Main [style=dashed, arrowhead=vee, color="#555555", label=" «call» ", fontcolor="#444444"];
  c_ChayDemo -> c_Main [style=dashed, arrowhead=vee, color="#555555", label=" «call» ", fontcolor="#444444"];
  c_ConsoleMenu -> c_InputReader [arrowhead=vee, label=" -input ", taillabel="  ", headlabel=" 1 ", labeldistance=1.6, labelangle=40];
  c_ConsoleMenu -> c_MenuService [arrowhead=vee, label=" -menu ", taillabel="  ", headlabel=" 1 ", labeldistance=1.6, labelangle=40];
  c_ConsoleMenu -> c_TableService [arrowhead=vee, label=" -tables ", taillabel="  ", headlabel=" 1 ", labeldistance=1.6, labelangle=40];
  c_ConsoleMenu -> c_OrderService [arrowhead=vee, label=" -orders ", taillabel="  ", headlabel=" 1 ", labeldistance=1.6, labelangle=40];
  c_MainWindow -> c_MenuService [arrowhead=vee, label=" -menu ", taillabel="  ", headlabel=" 1 ", labeldistance=1.6, labelangle=40];
  c_MainWindow -> c_TableService [arrowhead=vee, label=" -tables ", taillabel="  ", headlabel=" 1 ", labeldistance=1.6, labelangle=40];
  c_MainWindow -> c_OrderService [arrowhead=vee, label=" -orders ", taillabel="  ", headlabel=" 1 ", labeldistance=1.6, labelangle=40];
  c_OrderService -> c_TableService [arrowhead=vee, label=" -tables ", taillabel="  ", headlabel=" 1 ", labeldistance=1.6, labelangle=40];
  c_OrderService -> c_MenuService [arrowhead=vee, label=" -menu ", taillabel="  ", headlabel=" 1 ", labeldistance=1.6, labelangle=40];
  c_OrderService -> c_BillCalculator [arrowhead=vee, label=" -calculator ", taillabel="  ", headlabel=" 1 ", labeldistance=1.6, labelangle=40];
  c_OrderService -> c_BillArchive [arrowhead=vee, label=" -archive ", taillabel="  ", headlabel=" 1 ", labeldistance=1.6, labelangle=40];
  c_OrderService -> c_Repository [arrowhead=vee, label=" -orders <Order, Integer> ", taillabel="  ", headlabel=" 1 ", labeldistance=1.6, labelangle=40];
  c_MenuService -> c_Repository [arrowhead=vee, label=" -repo <MenuItem, String> ", taillabel="  ", headlabel=" 1 ", labeldistance=1.6, labelangle=40];
  c_TableService -> c_Repository [arrowhead=vee, label=" -repo <Table, Integer> ", taillabel="  ", headlabel=" 1 ", labeldistance=1.6, labelangle=40];
  c_OrderService -> c_CheckoutResult [style=dashed, arrowhead=vee, color="#555555", label=" «create» ", fontcolor="#444444"];
  c_OrderService -> c_DiscountStrategy [style=dashed, arrowhead=vee, color="#555555", label=" «use» ", fontcolor="#444444"];
  c_ConsoleMenu -> c_DiscountStrategy [style=dashed, arrowhead=vee, color="#555555", label=" «use» ", fontcolor="#444444"];
  c_MainWindow -> c_DiscountStrategy [style=dashed, arrowhead=vee, color="#555555", label=" «use» ", fontcolor="#444444"];
  c_OrderService -> c_ItemSales [style=dashed, arrowhead=vee, color="#555555", label=" «create» ", fontcolor="#444444"];
  c_Repository -> c_InMemoryRepository [dir=back, arrowtail=empty, style=dashed, arrowsize=1.25];
  c_Repository -> c_FileMenuRepository [dir=back, arrowtail=empty, style=dashed, arrowsize=1.25, headlabel=" T = MenuItem, ID = String ", labeldistance=2.2, labelangle=-30];
  c_BillArchive -> c_FileBillArchive [dir=back, arrowtail=empty, style=dashed, arrowsize=1.25];
  c_FileMenuRepository -> c_MenuItemFactory [style=dashed, arrowhead=vee, color="#555555", label=" «use» ", fontcolor="#444444"];
