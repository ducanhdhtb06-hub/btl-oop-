---
title: Biểu đồ lớp - gói model và pricing
config:
  layout: elk
---
classDiagram
    direction TB

    class Identifiable~ID~ {
        <<interface>>
        +getId() ID
    }

    class MenuItem {
        <<abstract>>
        -String id
        -String name
        -boolean available
        #MenuItem(id, name, available)
        +getId() String
        +getName() String
        +isAvailable() boolean
        +setAvailable(boolean) void
        +isVegetarian() boolean
        +getPrice()* long
        +getType()* ItemType
        +describe()* String
        +toCsvRow()* String
        +equals(Object) boolean
        +hashCode() int
    }

    class SimpleMenuItem {
        <<abstract>>
        -long price
        +getPrice() long
        +changePrice(long) void
    }

    class Food {
        -boolean vegetarian
        +isVegetarian() boolean
        +getType() ItemType
        +describe() String
        +toCsvRow() String
    }

    class Drink {
        -int volumeMl
        +getVolumeMl() int
        +getType() ItemType
        +describe() String
        +toCsvRow() String
    }

    class Combo {
        -int discountPercent
        -List~MenuItem~ components
        +getComponents() List~MenuItem~
        +getPrice() long
        +isAvailable() boolean
        +isVegetarian() boolean
        +describe() String
        +toCsvRow() String
    }

    class ItemType {
        <<enumeration>>
        FOOD
        DRINK
        COMBO
    }

    class MenuItemFactory {
        +fromCsvRow(String row, Function lookup)$ MenuItem
    }

    class Table {
        -int number
        -int seats
        -TableStatus status
        +isFree() boolean
        +occupy() void
        +release() void
    }

    class TableStatus {
        <<enumeration>>
        FREE
        OCCUPIED
    }

    class Order {
        -int id
        -LocalDateTime createdAt
        -OrderStatus status
        +addItem(MenuItem) void
        +addItem(MenuItem, int) void
        +updateQuantity(String, int) void
        +removeItem(String) void
        +getItems() List~OrderItem~
        +subtotal() long
        +isEmpty() boolean
        +markPaid() void
        +cancel() void
    }

    class OrderStatus {
        <<enumeration>>
        OPEN
        PAID
        CANCELLED
    }

    class OrderItem {
        -long unitPrice
        -int quantity
        ~OrderItem(MenuItem, int)
        ~setQuantity(int) void
        +lineTotal() long
    }

    class Bill {
        <<record>>
        int orderId
        int tableNumber
        LocalDateTime issuedAt
        long subtotal
        String discountLabel
        long discount
        long total
    }

    class BillLine {
        <<record>>
        String itemName
        int quantity
        long unitPrice
        long lineTotal
    }

    class DiscountStrategy {
        <<interface>>
        +discountFor(long subtotal) long
        +label() String
    }

    class NoDiscount
    class PercentageDiscount {
        -int percent
    }
    class FixedAmountDiscount {
        -long amount
    }

    class BillCalculator {
        +calculate(Order, DiscountStrategy, LocalDateTime) Bill
    }

    %% Kế thừa (3 tầng) và hiện thực interface
    Identifiable <|.. MenuItem
    Identifiable <|.. Table
    Identifiable <|.. Order
    MenuItem <|-- SimpleMenuItem
    SimpleMenuItem <|-- Food
    SimpleMenuItem <|-- Drink
    MenuItem <|-- Combo
    DiscountStrategy <|.. NoDiscount
    DiscountStrategy <|.. PercentageDiscount
    DiscountStrategy <|.. FixedAmountDiscount

    %% Hợp thành: OrderItem sinh ra và mất đi cùng Order
    Order "1" *-- "0..*" OrderItem : gồm
    Bill "1" *-- "1..*" BillLine : gồm

    %% Tụ hợp: món thành phần tồn tại độc lập với Combo
    Combo "0..*" o-- "1..*" MenuItem : thành phần

    %% Kết hợp
    Order "0..*" --> "1" Table : của bàn
    OrderItem "0..*" --> "1" MenuItem : món
    Order --> OrderStatus
    Table --> TableStatus

    %% Phụ thuộc
    MenuItem ..> ItemType
    MenuItemFactory ..> MenuItem : tạo
    BillCalculator ..> Order : đọc
    BillCalculator ..> DiscountStrategy : dùng
    BillCalculator ..> Bill : tạo
