digraph UML {
  graph [fontname="DejaVu Sans", fontsize=17, label=<<B>Biểu đồ lớp 1 - Gói model và pricing (các lớp nghiệp vụ)</B>>, labelloc=t, labeljust=c,
         rankdir=TB, nodesep=0.5, ranksep=0.8, newrank=true, pad=0.35, bgcolor=white];
  node [shape=plain, fontname="DejaVu Sans", fontsize=11];
  edge [fontname="DejaVu Sans", fontsize=10, color="#333333", arrowsize=0.95, labelfontsize=10, labelfontcolor="#1a1a1a"];
  subgraph cluster_model {
    label=<<B>restaurant.model</B>>; labeljust=l; fontsize=13; style="rounded"; color="#8a8a8a"; bgcolor="#fbfbfb"; penwidth=1.2;
    c_Identifiable [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#3a3a3a" BGCOLOR="#fff8e1"><TR><TD ALIGN="CENTER" CELLPADDING="5"><FONT POINT-SIZE="10">«interface»</FONT><BR/><B>Identifiable&lt;ID&gt;</B></TD></TR><HR/><TR><TD CELLPADDING="1"> </TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><I>+getId() : ID</I><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    c_MenuItem [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#3a3a3a" BGCOLOR="#eef3fa"><TR><TD ALIGN="CENTER" CELLPADDING="5"><FONT POINT-SIZE="10">«abstract»</FONT><BR/><I><B>MenuItem</B></I></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">-id : String<BR ALIGN="LEFT"/>-name : String<BR ALIGN="LEFT"/>-available : boolean<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">#MenuItem(id: String, name: String, available: boolean)<BR ALIGN="LEFT"/>+getId() : String<BR ALIGN="LEFT"/>+getName() : String<BR ALIGN="LEFT"/>+isAvailable() : boolean<BR ALIGN="LEFT"/>+setAvailable(available: boolean) : void<BR ALIGN="LEFT"/>+isMarkedAvailable() : boolean<BR ALIGN="LEFT"/>+isVegetarian() : boolean<BR ALIGN="LEFT"/><I>+getPrice() : long</I><BR ALIGN="LEFT"/><I>+getType() : ItemType</I><BR ALIGN="LEFT"/><I>+describe() : String</I><BR ALIGN="LEFT"/><I>+toCsvRow() : String</I><BR ALIGN="LEFT"/>+equals(other: Object) : boolean<BR ALIGN="LEFT"/>+hashCode() : int<BR ALIGN="LEFT"/>+toString() : String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    c_SimpleMenuItem [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#3a3a3a" BGCOLOR="#eef3fa"><TR><TD ALIGN="CENTER" CELLPADDING="5"><FONT POINT-SIZE="10">«abstract»</FONT><BR/><I><B>SimpleMenuItem</B></I></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">-price : long<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">#SimpleMenuItem(id: String, name: String, price: long,<BR ALIGN="LEFT"/>&#160;&#160;&#160;&#160;available: boolean)<BR ALIGN="LEFT"/>+getPrice() : long<BR ALIGN="LEFT"/>+changePrice(newPrice: long) : void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    c_Food [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#3a3a3a" BGCOLOR="#eef3fa"><TR><TD ALIGN="CENTER" CELLPADDING="5"><B>Food</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">-vegetarian : boolean<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+Food(id: String, name: String, price: long,<BR ALIGN="LEFT"/>&#160;&#160;&#160;&#160;available: boolean, vegetarian: boolean)<BR ALIGN="LEFT"/>+isVegetarian() : boolean<BR ALIGN="LEFT"/>+getType() : ItemType<BR ALIGN="LEFT"/>+describe() : String<BR ALIGN="LEFT"/>+toCsvRow() : String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    c_Drink [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#3a3a3a" BGCOLOR="#eef3fa"><TR><TD ALIGN="CENTER" CELLPADDING="5"><B>Drink</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">-volumeMl : int<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+Drink(id: String, name: String, price: long,<BR ALIGN="LEFT"/>&#160;&#160;&#160;&#160;available: boolean, volumeMl: int)<BR ALIGN="LEFT"/>+getVolumeMl() : int<BR ALIGN="LEFT"/>+isVegetarian() : boolean<BR ALIGN="LEFT"/>+getType() : ItemType<BR ALIGN="LEFT"/>+describe() : String<BR ALIGN="LEFT"/>+toCsvRow() : String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    c_Combo [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#3a3a3a" BGCOLOR="#eef3fa"><TR><TD ALIGN="CENTER" CELLPADDING="5"><B>Combo</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">-discountPercent : int<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+Combo(id: String, name: String, available: boolean,<BR ALIGN="LEFT"/>&#160;&#160;&#160;&#160;discountPercent: int, components: List&lt;MenuItem&gt;)<BR ALIGN="LEFT"/>+getComponents() : List&lt;MenuItem&gt;<BR ALIGN="LEFT"/>+getDiscountPercent() : int<BR ALIGN="LEFT"/>+getPrice() : long<BR ALIGN="LEFT"/>+isAvailable() : boolean<BR ALIGN="LEFT"/>+isVegetarian() : boolean<BR ALIGN="LEFT"/>+getType() : ItemType<BR ALIGN="LEFT"/>+describe() : String<BR ALIGN="LEFT"/>+toCsvRow() : String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    c_ItemType [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#3a3a3a" BGCOLOR="#eef7ee"><TR><TD ALIGN="CENTER" CELLPADDING="5"><FONT POINT-SIZE="10">«enumeration»</FONT><BR/><B>ItemType</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">FOOD<BR ALIGN="LEFT"/>DRINK<BR ALIGN="LEFT"/>COMBO<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    c_MenuItemFactory [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#3a3a3a" BGCOLOR="#eef3fa"><TR><TD ALIGN="CENTER" CELLPADDING="5"><FONT POINT-SIZE="10">«utility»</FONT><BR/><B>MenuItemFactory</B></TD></TR><HR/><TR><TD CELLPADDING="1"> </TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><U>+fromCsvRow(row: String,</U><BR ALIGN="LEFT"/><U>&#160;&#160;&#160;&#160;lookup: Function&lt;String, Optional&lt;MenuItem&gt;&gt;) : MenuItem</U><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    c_Table [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#3a3a3a" BGCOLOR="#eef3fa"><TR><TD ALIGN="CENTER" CELLPADDING="5"><B>Table</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">-number : int<BR ALIGN="LEFT"/>-seats : int<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+Table(number: int, seats: int)<BR ALIGN="LEFT"/>+getId() : Integer<BR ALIGN="LEFT"/>+getNumber() : int<BR ALIGN="LEFT"/>+getSeats() : int<BR ALIGN="LEFT"/>+getStatus() : TableStatus<BR ALIGN="LEFT"/>+isFree() : boolean<BR ALIGN="LEFT"/>+occupy() : void<BR ALIGN="LEFT"/>+release() : void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    c_TableStatus [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#3a3a3a" BGCOLOR="#eef7ee"><TR><TD ALIGN="CENTER" CELLPADDING="5"><FONT POINT-SIZE="10">«enumeration»</FONT><BR/><B>TableStatus</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">FREE<BR ALIGN="LEFT"/>OCCUPIED<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    c_Order [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#3a3a3a" BGCOLOR="#eef3fa"><TR><TD ALIGN="CENTER" CELLPADDING="5"><B>Order</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><U>+MAX_QUANTITY : int = 99</U><BR ALIGN="LEFT"/>-id : int<BR ALIGN="LEFT"/>-createdAt : LocalDateTime<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+Order(id: int, table: Table, createdAt: LocalDateTime)<BR ALIGN="LEFT"/>+getId() : Integer<BR ALIGN="LEFT"/>+getTable() : Table<BR ALIGN="LEFT"/>+getCreatedAt() : LocalDateTime<BR ALIGN="LEFT"/>+getStatus() : OrderStatus<BR ALIGN="LEFT"/>+addItem(item: MenuItem) : void<BR ALIGN="LEFT"/>+addItem(item: MenuItem, quantity: int) : void<BR ALIGN="LEFT"/>+updateQuantity(itemId: String, quantity: int) : void<BR ALIGN="LEFT"/>+removeItem(itemId: String) : void<BR ALIGN="LEFT"/>+getItems() : List&lt;OrderItem&gt;<BR ALIGN="LEFT"/>+subtotal() : long<BR ALIGN="LEFT"/>+isEmpty() : boolean<BR ALIGN="LEFT"/>+markPaid() : void<BR ALIGN="LEFT"/>+cancel() : void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    c_OrderStatus [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#3a3a3a" BGCOLOR="#eef7ee"><TR><TD ALIGN="CENTER" CELLPADDING="5"><FONT POINT-SIZE="10">«enumeration»</FONT><BR/><B>OrderStatus</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">OPEN<BR ALIGN="LEFT"/>PAID<BR ALIGN="LEFT"/>CANCELLED<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    c_OrderItem [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#3a3a3a" BGCOLOR="#eef3fa"><TR><TD ALIGN="CENTER" CELLPADDING="5"><B>OrderItem</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">-unitPrice : long<BR ALIGN="LEFT"/>-quantity : int<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">~OrderItem(item: MenuItem, quantity: int)<BR ALIGN="LEFT"/>+getItem() : MenuItem<BR ALIGN="LEFT"/>+getUnitPrice() : long<BR ALIGN="LEFT"/>+getQuantity() : int<BR ALIGN="LEFT"/>+lineTotal() : long<BR ALIGN="LEFT"/>~setQuantity(quantity: int) : void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    c_Bill [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#3a3a3a" BGCOLOR="#eef7ee"><TR><TD ALIGN="CENTER" CELLPADDING="5"><FONT POINT-SIZE="10">«record»</FONT><BR/><B>Bill</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">-orderId : int<BR ALIGN="LEFT"/>-tableNumber : int<BR ALIGN="LEFT"/>-issuedAt : LocalDateTime<BR ALIGN="LEFT"/>-subtotal : long<BR ALIGN="LEFT"/>-discountLabel : String<BR ALIGN="LEFT"/>-discount : long<BR ALIGN="LEFT"/>-total : long<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    c_BillLine [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#3a3a3a" BGCOLOR="#eef7ee"><TR><TD ALIGN="CENTER" CELLPADDING="5"><FONT POINT-SIZE="10">«record»</FONT><BR/><B>BillLine</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">-itemName : String<BR ALIGN="LEFT"/>-quantity : int<BR ALIGN="LEFT"/>-unitPrice : long<BR ALIGN="LEFT"/>-lineTotal : long<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  }
  subgraph cluster_pricing {
    label=<<B>restaurant.pricing</B>>; labeljust=l; fontsize=13; style="rounded"; color="#8a8a8a"; bgcolor="#fbfbfb"; penwidth=1.2;
    c_DiscountStrategy [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#3a3a3a" BGCOLOR="#fff8e1"><TR><TD ALIGN="CENTER" CELLPADDING="5"><FONT POINT-SIZE="10">«interface»</FONT><BR/><B>DiscountStrategy</B></TD></TR><HR/><TR><TD CELLPADDING="1"> </TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><I>+discountFor(subtotal: long) : long</I><BR ALIGN="LEFT"/>+label() : String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    c_NoDiscount [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#3a3a3a" BGCOLOR="#eef3fa"><TR><TD ALIGN="CENTER" CELLPADDING="5"><B>NoDiscount</B></TD></TR><HR/><TR><TD CELLPADDING="1"> </TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+discountFor(subtotal: long) : long<BR ALIGN="LEFT"/>+label() : String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    c_PercentageDiscount [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#3a3a3a" BGCOLOR="#eef3fa"><TR><TD ALIGN="CENTER" CELLPADDING="5"><B>PercentageDiscount</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">-percent : int<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+PercentageDiscount(percent: int)<BR ALIGN="LEFT"/>+discountFor(subtotal: long) : long<BR ALIGN="LEFT"/>+label() : String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    c_FixedAmountDiscount [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#3a3a3a" BGCOLOR="#eef3fa"><TR><TD ALIGN="CENTER" CELLPADDING="5"><B>FixedAmountDiscount</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">-amount : long<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+FixedAmountDiscount(amount: long)<BR ALIGN="LEFT"/>+discountFor(subtotal: long) : long<BR ALIGN="LEFT"/>+label() : String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    c_BillCalculator [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#3a3a3a" BGCOLOR="#eef3fa"><TR><TD ALIGN="CENTER" CELLPADDING="5"><B>BillCalculator</B></TD></TR><HR/><TR><TD CELLPADDING="1"> </TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5">+calculate(order: Order, strategy: DiscountStrategy,<BR ALIGN="LEFT"/>&#160;&#160;&#160;&#160;issuedAt: LocalDateTime) : Bill<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  }
  c_Identifiable -> c_MenuItem [dir=back, arrowtail=empty, style=dashed, arrowsize=1.25, label=" ID = String "];
  c_Identifiable -> c_Table [dir=back, arrowtail=empty, style=dashed, arrowsize=1.25, label=" ID = Integer "];
  c_Identifiable -> c_Order [dir=back, arrowtail=empty, style=dashed, arrowsize=1.25, label=" ID = Integer "];
  c_DiscountStrategy -> c_NoDiscount [dir=back, arrowtail=empty, style=dashed, arrowsize=1.25];
  c_DiscountStrategy -> c_PercentageDiscount [dir=back, arrowtail=empty, style=dashed, arrowsize=1.25];
  c_DiscountStrategy -> c_FixedAmountDiscount [dir=back, arrowtail=empty, style=dashed, arrowsize=1.25];
  c_MenuItem -> c_SimpleMenuItem [dir=back, arrowtail=empty, arrowsize=1.25];
  c_SimpleMenuItem -> c_Food [dir=back, arrowtail=empty, arrowsize=1.25];
  c_SimpleMenuItem -> c_Drink [dir=back, arrowtail=empty, arrowsize=1.25];
  c_MenuItem -> c_Combo [dir=back, arrowtail=empty, arrowsize=1.25];
  c_Order -> c_OrderItem [dir=back, arrowtail=diamond, arrowsize=1.35, label=" -items ", taillabel=" 1 ", headlabel=" 0..* ", labeldistance=2.1, labelangle=32];
  c_Bill -> c_BillLine [dir=back, arrowtail=diamond, arrowsize=1.35, label=" -lines ", taillabel=" 1 ", headlabel=" 0..* ", labeldistance=2.1, labelangle=32];
  c_Combo -> c_MenuItem [dir=back, arrowtail=odiamond, arrowsize=1.35, label=" -components ", taillabel=" 0..* ", headlabel=" 1..* ", labeldistance=2.1, labelangle=32];
  c_OrderItem -> c_MenuItem [arrowhead=vee, label=" -item ", taillabel=" 0..* ", headlabel=" 1 ", labeldistance=2.1, labelangle=32];
  c_Order -> c_Table [arrowhead=vee, label=" -table ", taillabel=" 0..* ", headlabel=" 1 ", labeldistance=2.1, labelangle=32];
  c_Order -> c_OrderStatus [arrowhead=vee, label=" -status ", taillabel=" 0..* ", headlabel=" 1 ", labeldistance=2.1, labelangle=32];
  c_Table -> c_TableStatus [arrowhead=vee, label=" -status ", taillabel=" 0..* ", headlabel=" 1 ", labeldistance=2.1, labelangle=32];
  c_MenuItem -> c_ItemType [style=dashed, arrowhead=vee, color="#555555", label=" «use» ", fontcolor="#444444"];
  c_MenuItemFactory -> c_Food [style=dashed, arrowhead=vee, color="#555555", label=" «create» ", fontcolor="#444444"];
  c_MenuItemFactory -> c_Drink [style=dashed, arrowhead=vee, color="#555555", label=" «create» ", fontcolor="#444444"];
  c_MenuItemFactory -> c_Combo [style=dashed, arrowhead=vee, color="#555555", label=" «create» ", fontcolor="#444444"];
  c_BillCalculator -> c_Order [style=dashed, arrowhead=vee, color="#555555", label=" «use» ", fontcolor="#444444"];
  c_BillCalculator -> c_DiscountStrategy [style=dashed, arrowhead=vee, color="#555555", label=" «use» ", fontcolor="#444444"];
  c_BillCalculator -> c_Bill [style=dashed, arrowhead=vee, color="#555555", label=" «create» ", fontcolor="#444444"];
  c_BillCalculator -> c_BillLine [style=dashed, arrowhead=vee, color="#555555", label=" «create» ", fontcolor="#444444"];
}
