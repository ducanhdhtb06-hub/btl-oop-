<mxCell id="note94" value="Tạo các đối tượng chính rồi truyền vào nhau qua hàm tạo: FileMenuRepository, 2 InMemoryRepository, MenuService, TableService, OrderService, BillCalculator, FileBillArchive, rồi ConsoleMenu và InputReader, hoặc MainWindow nếu có --gui" style="shape=note;whiteSpace=wrap;html=1;size=12;fontSize=10;fontFamily=Helvetica;fillColor=#fffde7;strokeColor=#9e9e9e;align=center;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="871.6" y="481.6" width="245.7" height="81.4" as="geometry"/></mxCell>
<mxCell id="note95" value="ConsoleMenu và MainWindow tạo NoDiscount, PercentageDiscount hoặc FixedAmountDiscount (hình 1) rồi truyền vào OrderService.checkout" style="shape=note;whiteSpace=wrap;html=1;size=12;fontSize=10;fontFamily=Helvetica;fillColor=#fffde7;strokeColor=#9e9e9e;align=center;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="2857.8" y="1338.3" width="264.6" height="57.2" as="geometry"/></mxCell>
<mxCell id="note96" value="ConsoleMenu và MainWindow cũng dùng BillFormatter và MoneyFormat để in hóa đơn và giá tiền (không vẽ các đường này cho đỡ rối)" style="shape=note;whiteSpace=wrap;html=1;size=12;fontSize=10;fontFamily=Helvetica;fillColor=#fffde7;strokeColor=#9e9e9e;align=center;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="3219.1" y="1787.8" width="248.9" height="57.2" as="geometry"/></mxCell>
<mxCell id="note97" value="Còn 12 thuộc tính giao diện khác (bảng, ô số lượng, ô giảm giá...) không vẽ cho gọn. Giữ JFrame bên trong thay vì kế thừa JFrame" style="shape=note;whiteSpace=wrap;html=1;size=12;fontSize=10;fontFamily=Helvetica;fillColor=#fffde7;strokeColor=#9e9e9e;align=center;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="2348.9" y="785.8" width="246.8" height="45.1" as="geometry"/></mxCell>
