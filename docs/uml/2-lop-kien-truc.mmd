---
title: Biểu đồ lớp - kiến trúc phân tầng (ui → service → repository)
config:
  layout: elk
---
classDiagram
    direction TB

    class Main {
        +main(String[] args)$ void
    }

    class ConsoleMenu {
        -InputReader input
        -PrintStream out
        +run() void
    }
    class InputReader {
        +readInt(String, int min, int max) int
        +readNonBlank(String) String
        +confirm(String) boolean
    }
    class MainWindow {
        +show() void
        +showWarnings(List~String~) void
    }

    class MenuService {
        +all() List~MenuItem~
        +byType(ItemType) List~MenuItem~
        +vegetarian() List~MenuItem~
        +find(String id) MenuItem
        +addFood(String, long, boolean) Food
        +addDrink(String, long, int) Drink
        +changePrice(String, long) void
        +toggleAvailable(String) boolean
    }
    class TableService {
        +defaultTables()$ List~Table~
        +all() List~Table~
        +find(int) Table
    }
    class OrderService {
        -Clock clock
        +openOrder(int tableNo) Order
        +currentOrder(int tableNo) Order
        +addItem(int, String, int) void
        +updateQuantity(int, String, int) void
        +removeItem(int, String) void
        +checkout(int, DiscountStrategy) CheckoutResult
        +cancel(int tableNo) void
        +bestSellers(int limit) List~ItemSales~
    }
    class CheckoutResult {
        <<record>>
        Bill bill
        boolean archived
    }
    class ItemSales {
        <<record>>
        String itemName
        int quantity
        long revenue
    }
    class BillCalculator {
        +calculate(Order, DiscountStrategy, LocalDateTime) Bill
    }

    note for Repository "T extends Identifiable&lt;ID&gt;"
    class Repository~T, ID~ {
        <<interface>>
        +findAll() List~T~
        +findById(ID) Optional~T~
        +save(T) void
    }
    class InMemoryRepository~T, ID~ {
        -Map~ID, T~ entities
    }
    class FileMenuRepository {
        -Path file
        -Map~String, MenuItem~ items
        +getWarnings() List~String~
    }
    class BillArchive {
        <<interface>>
        +archive(Bill) void
    }
    class FileBillArchive {
        -Path file
    }

    %% Tầng giao diện chỉ biết tầng service
    Main ..> ConsoleMenu : tạo
    Main ..> MainWindow : tạo
    Main ..> FileMenuRepository : tạo
    ConsoleMenu "1" --> "1" InputReader
    ConsoleMenu --> MenuService
    ConsoleMenu --> TableService
    ConsoleMenu --> OrderService
    MainWindow --> MenuService
    MainWindow --> TableService
    MainWindow --> OrderService

    %% Tầng service chỉ biết interface, không biết file
    OrderService --> TableService
    OrderService --> MenuService
    OrderService --> BillCalculator
    OrderService --> BillArchive
    OrderService --> Repository : đơn
    MenuService --> Repository : món
    TableService --> Repository : bàn
    OrderService ..> CheckoutResult : trả về
    OrderService ..> ItemSales : trả về

    %% Các cài đặt cụ thể
    Repository <|.. InMemoryRepository
    Repository <|.. FileMenuRepository
    BillArchive <|.. FileBillArchive
