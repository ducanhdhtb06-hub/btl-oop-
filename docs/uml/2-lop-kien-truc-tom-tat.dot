  c_OrderService -> c_MenuService [arrowhead=vee, label=" -menu ", taillabel="  ", headlabel=" 1 ", labeldistance=2.1, labelangle=32];
  c_OrderService -> c_BillCalculator [arrowhead=vee, label=" -calculator ", taillabel="  ", headlabel=" 1 ", labeldistance=2.1, labelangle=32];
  c_OrderService -> c_BillArchive [arrowhead=vee, label=" -archive ", taillabel="  ", headlabel=" 1 ", labeldistance=2.1, labelangle=32];
  c_OrderService -> c_Repository [arrowhead=vee, label=" -orders <Order, Integer> ", taillabel="  ", headlabel=" 1 ", labeldistance=2.1, labelangle=32];
  c_MenuService -> c_Repository [arrowhead=vee, label=" -repo <MenuItem, String> ", taillabel="  ", headlabel=" 1 ", labeldistance=2.1, labelangle=32];
  c_TableService -> c_Repository [arrowhead=vee, label=" -repo <Table, Integer> ", taillabel="  ", headlabel=" 1 ", labeldistance=2.1, labelangle=32];
  c_OrderService -> c_CheckoutResult [style=dashed, arrowhead=vee, color="#555555", label=" «create» ", fontcolor="#444444"];
  c_OrderService -> c_DiscountStrategy [style=dashed, arrowhead=vee, color="#555555", label=" «use» ", fontcolor="#444444"];
  c_ConsoleMenu -> c_DiscountStrategy [style=dashed, arrowhead=vee, color="#555555", label=" «use» ", fontcolor="#444444"];
  c_MainWindow -> c_DiscountStrategy [style=dashed, arrowhead=vee, color="#555555", label=" «use» ", fontcolor="#444444"];
  c_OrderService -> c_ItemSales [style=dashed, arrowhead=vee, color="#555555", label=" «create» ", fontcolor="#444444"];
  c_Repository -> c_InMemoryRepository [dir=back, arrowtail=empty, style=dashed, arrowsize=1.25];
  c_Repository -> c_FileMenuRepository [dir=back, arrowtail=empty, style=dashed, arrowsize=1.25, label=" T = MenuItem, ID = String "];
  c_BillArchive -> c_FileBillArchive [dir=back, arrowtail=empty, style=dashed, arrowsize=1.25];
  c_FileMenuRepository -> c_MenuItemFactory [style=dashed, arrowhead=vee, color="#555555", label=" «use» ", fontcolor="#444444"];
  c_FileMenuRepository -> c_SampleMenu [style=dashed, arrowhead=vee, color="#555555", label=" «use» ", fontcolor="#444444"];
  c_FileBillArchive -> c_BillFormatter [style=dashed, arrowhead=vee, color="#555555", label=" «use» ", fontcolor="#444444"];
  c_BillFormatter -> c_MoneyFormat [style=dashed, arrowhead=vee, color="#555555", label=" «use» ", fontcolor="#444444"];
}
